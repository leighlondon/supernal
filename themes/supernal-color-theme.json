  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#888a8d"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#2fe3a1"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#eeafaf"
      }
    },
    {
      "name": "Escape",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#2fe3a1"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "constant.language.boolean",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#a07ee3ed"
      }
